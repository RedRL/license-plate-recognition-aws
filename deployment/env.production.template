# Production Environment Configuration for License Plate Recognition
# This file is a template - actual values are set by CloudFormation during deployment

# AWS Configuration
AWS_REGION=eu-central-1
S3_BUCKET=lpr-images-bucket-name

# Database Configuration (RDS MySQL)
DB_HOST=database-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=license_plates_db
DB_USER=admin
DB_PASSWORD=your-secure-password

# Application Mode
LOCAL_MODE=false

# OpenALPR Configuration
ALPR_COUNTRY=eu

# Upload Directory
UPLOAD_DIR=/opt/lpr-app/backend/uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=/opt/lpr-app/backend/logs/app.log

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0


